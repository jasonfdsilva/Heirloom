# Database
DATABASE_URL=postgresql+asyncpg://heirloom:heirloom@localhost:5432/heirloom

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=heirloom
S3_PUBLIC_URL=http://localhost:9000/heirloom

# Anthropic (for seed packet extraction)
ANTHROPIC_API_KEY=your-key-here

# Garden defaults (Berkeley Heights NJ, zip 07922, Zone 6b)
DEFAULT_LAST_FROST_DATE=04-23
DEFAULT_FIRST_FROST_DATE=10-22
